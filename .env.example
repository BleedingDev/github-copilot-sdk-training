COPILOT_MODEL=gpt-5.2-codex
COPILOT_PLAN_MODEL=gpt-5.3-codex
COPILOT_IMPLEMENT_MODEL=gpt-5.4-mini
COPILOT_REVIEW_MODEL=gpt-5.5
COPILOT_TIMEOUT_MS=180000
COPILOT_START_TIMEOUT_MS=30000
COPILOT_FLEET_TIMEOUT_MS=180000
COPILOT_FLEET_POLL_MS=5000
COPILOT_FLEET_IDLE_GRACE_MS=30000
COPILOT_MAX_GATE_ATTEMPTS=3
COPILOT_EXPECT_TIMEOUT_MS=1800000
COPILOT_EVENT_LOG=compact
NODE_OPTIONS=--no-deprecation
COPILOT_GITHUB_TOKEN=
