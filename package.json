{
  "name": "github-copilot-sdk-training",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "auth": "./scripts/copilot-login.sh",
    "lab": "tsx src/index.ts",
    "lab:help": "tsx src/index.ts help",
    "lab:dry-run": "tsx src/index.ts dry-run",
    "verify": "pnpm run typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docker:build": "docker build -t github-copilot-sdk-training .",
    "docker:shell": "docker compose run --rm lab zsh",
    "docker:verify": "docker compose run --rm lab pnpm run verify"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.0-beta.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@github/copilot": "1.0.43",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
